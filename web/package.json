{
  "name": "signalforge-web",
  "version": "0.1.0",
  "description": "SignalForge shared UI primitives for signal dictionaries, wall management, uPlot tile rendering, and tile-pyramid clients.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/egidinas/signalforge.git",
    "directory": "web"
  },
  "main": "./dist/signalforge-web.es.js",
  "module": "./dist/signalforge-web.es.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/signalforge-web.es.js"
    },
    "./styles.css": {
      "default": "./src/styles.css"
    }
  },
  "files": [
    "dist",
    "src/styles.css"
  ],
  "scripts": {
    "build": "tsc -b && vite build",
    "test": "node --experimental-vm-modules node_modules/.bin/jest --testPathPattern=tests/",
    "demo:dev": "vite --config vite.demo.config.ts --host 0.0.0.0",
    "demo:build": "vite build --config vite.demo.config.ts",
    "typecheck": "tsc -b"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0",
    "uplot": ">=1.6.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jest": "^29.7.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.6.3",
    "uplot": "^1.6.32",
    "vite": "^5.4.10",
    "vite-plugin-dts": "^4.5.4"
  }
}
